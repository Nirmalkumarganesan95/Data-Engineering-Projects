{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "nirmal-df-spotify-project"
		},
		"SpotifyProjectLS1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SpotifyProjectLS1'"
		},
		"SpotifyProjectDataLakeStorageLS1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'SpotifyProjectDataLakeStorageLS1'"
		},
		"SpotifyProjectLS1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "nk-spotify-project.database.windows.net"
		},
		"SpotifyProjectLS1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Spotify_Project"
		},
		"SpotifyProjectLS1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "nirmal"
		},
		"SpotifyProjectDataLakeStorageLS1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://nkspotifyprojectstorage.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "nirmal-df-spotify-project_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"SpotifyProjectLS1_password": {
						"value": "[parameters('SpotifyProjectLS1_password')]"
					},
					"SpotifyProjectDataLakeStorageLS1_accountKey": {
						"value": "[parameters('SpotifyProjectDataLakeStorageLS1_accountKey')]"
					},
					"SpotifyProjectLS1_properties_typeProperties_server": {
						"value": "[parameters('SpotifyProjectLS1_properties_typeProperties_server')]"
					},
					"SpotifyProjectLS1_properties_typeProperties_database": {
						"value": "[parameters('SpotifyProjectLS1_properties_typeProperties_database')]"
					},
					"SpotifyProjectLS1_properties_typeProperties_userName": {
						"value": "[parameters('SpotifyProjectLS1_properties_typeProperties_userName')]"
					},
					"SpotifyProjectDataLakeStorageLS1_properties_typeProperties_url": {
						"value": "[parameters('SpotifyProjectDataLakeStorageLS1_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}